{
  "info": {
    "name": "PSP - Phone Service Platform (Full Test)",
    "description": "Bộ test API đầy đủ cho Phone Service Platform.\n\n**CÁCH DÙNG:**\n1. Import file này vào Postman\n2. Chạy folder Auth trước → Token tự động lưu\n3. Chạy tiếp Branch → User\n\nMọi token đều tự động gắn sau khi Login thành công.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl",      "value": "http://localhost:5000/api" },
    { "key": "accessToken",  "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "branchId",     "value": "" },
    { "key": "userId",       "value": "" }
  ],
  "item": [

    {
      "name": "🔐 1. Auth",
      "item": [
        {
          "name": "[200] Login thành công",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "const b = pm.response.json();",
            "pm.test('code = SUCCESS', () => pm.expect(b.code).to.eql('SUCCESS'));",
            "pm.test('Có accessToken', () => pm.expect(b.data.accessToken).to.not.be.empty);",
            "pm.test('Có refreshToken', () => pm.expect(b.data.refreshToken).to.not.be.empty);",
            "pm.test('Có roles', () => pm.expect(b.data.roles).to.be.an('array').with.lengthOf.above(0));",
            "pm.test('Có permissions', () => pm.expect(b.data.permissions).to.be.an('array').with.lengthOf.above(0));",
            "pm.test('user.username = admin', () => pm.expect(b.data.user.username).to.eql('admin'));",
            "pm.collectionVariables.set('accessToken', b.data.accessToken);",
            "pm.collectionVariables.set('refreshToken', b.data.refreshToken);",
            "console.log('✅ Token saved. Roles:', b.data.roles);"
          ], "type": "text/javascript" }}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"Admin@123\"\n}" },
            "url": { "raw": "{{baseUrl}}/Auth/login", "host": ["{{baseUrl}}"], "path": ["Auth","login"] }
          }
        },
        {
          "name": "[401] Login - Sai mật khẩu",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 401', () => pm.response.to.have.status(401));",
            "const b = pm.response.json();",
            "pm.test('Không phải SUCCESS', () => pm.expect(b.code).to.not.eql('SUCCESS'));"
          ], "type": "text/javascript" }}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"SaiMatKhau\"\n}" },
            "url": { "raw": "{{baseUrl}}/Auth/login", "host": ["{{baseUrl}}"], "path": ["Auth","login"] }
          }
        },
        {
          "name": "[401] Login - Username không tồn tại",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 401', () => pm.response.to.have.status(401));"
          ], "type": "text/javascript" }}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"khongtontai\",\n  \"password\": \"abc123\"\n}" },
            "url": { "raw": "{{baseUrl}}/Auth/login", "host": ["{{baseUrl}}"], "path": ["Auth","login"] }
          }
        },
        {
          "name": "[400] Login - Thiếu username & password (Validation)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 400', () => pm.response.to.have.status(400));",
            "const b = pm.response.json();",
            "pm.test('Có thông báo lỗi', () => pm.expect(b.message).to.not.be.empty);"
          ], "type": "text/javascript" }}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"\",\n  \"password\": \"\"\n}" },
            "url": { "raw": "{{baseUrl}}/Auth/login", "host": ["{{baseUrl}}"], "path": ["Auth","login"] }
          }
        },
        {
          "name": "[200] Refresh Token",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "const b = pm.response.json();",
            "pm.test('Nhận token mới', () => pm.expect(b.data.accessToken).to.not.be.empty);",
            "pm.collectionVariables.set('accessToken', b.data.accessToken);",
            "pm.collectionVariables.set('refreshToken', b.data.refreshToken);",
            "console.log('✅ Token rotation thành công!');"
          ], "type": "text/javascript" }}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/Auth/refresh-token", "host": ["{{baseUrl}}"], "path": ["Auth","refresh-token"] }
          }
        },
        {
          "name": "[400] Refresh Token - Thiếu token (Validation)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 400', () => pm.response.to.have.status(400));"
          ], "type": "text/javascript" }}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"\"\n}" },
            "url": { "raw": "{{baseUrl}}/Auth/refresh-token", "host": ["{{baseUrl}}"], "path": ["Auth","refresh-token"] }
          }
        },
        {
          "name": "[200] Logout",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "const b = pm.response.json();",
            "pm.test('Logout thành công', () => pm.expect(b.code).to.eql('SUCCESS'));",
            "const oldRefresh = pm.collectionVariables.get('refreshToken');",
            "pm.collectionVariables.set('revokedRefreshToken', oldRefresh);",
            "pm.collectionVariables.set('accessToken', '');",
            "pm.collectionVariables.set('refreshToken', '');",
            "console.log('✅ Đã logout. Token bị xóa.');"
          ], "type": "text/javascript" }}],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/Auth/logout", "host": ["{{baseUrl}}"], "path": ["Auth","logout"] }
          }
        },
        {
          "name": "[401] Logout - Không có token (Unauthorized)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 401', () => pm.response.to.have.status(401));"
          ], "type": "text/javascript" }}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"token-nao-do\"\n}" },
            "url": { "raw": "{{baseUrl}}/Auth/logout", "host": ["{{baseUrl}}"], "path": ["Auth","logout"] }
          }
        },
        {
          "name": "⚙️ RE-LOGIN (lấy token lại để test tiếp)",
          "event": [{ "listen": "test", "script": { "exec": [
            "const b = pm.response.json();",
            "if (b.data) {",
            "  pm.collectionVariables.set('accessToken', b.data.accessToken);",
            "  pm.collectionVariables.set('refreshToken', b.data.refreshToken);",
            "  console.log('✅ Re-login thành công. Sẵn sàng test Branch/User.');",
            "}"
          ], "type": "text/javascript" }}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"Admin@123\"\n}" },
            "url": { "raw": "{{baseUrl}}/Auth/login", "host": ["{{baseUrl}}"], "path": ["Auth","login"] }
          }
        }
      ]
    },

