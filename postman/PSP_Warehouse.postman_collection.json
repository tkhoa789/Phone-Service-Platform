{
  "info": {
    "name": "PSP - Module 6: Warehouse (Kho hàng)",
    "description": "Bộ test API tích hợp tự động cho Module 6: Warehouse (Kho hàng) của Phone Service Platform.\n\n**HƯỚNG DẪN:**\n1. Import file này vào Postman.\n2. Chạy kịch bản đăng nhập để lấy Token.\n3. Lấy thông tin Chi nhánh gieo sẵn.\n4. Thực hiện CRUD và kiểm tra các ràng buộc.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "refreshToken",
      "value": ""
    },
    {
      "key": "branchId",
      "value": ""
    },
    {
      "key": "warehouseId1",
      "value": ""
    },
    {
      "key": "warehouseId2",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "🔐 0. Auth",
      "item": [
        {
          "name": "Đăng nhập hệ thống (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('code = SUCCESS', () => pm.expect(b.code).to.eql('SUCCESS'));",
                  "pm.test('Có accessToken', () => pm.expect(b.data.accessToken).to.not.be.empty);",
                  "pm.collectionVariables.set('accessToken', b.data.accessToken);",
                  "pm.collectionVariables.set('refreshToken', b.data.refreshToken);",
                  "console.log('✅ Đăng nhập thành công, đã lưu Token.');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"Admin@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/Auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "Auth",
                "login"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "🏢 1. Preparation",
      "item": [
        {
          "name": "Lấy danh sách Chi nhánh gieo sẵn",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('Có ít nhất 1 chi nhánh', () => pm.expect(b.data.length).to.be.above(0));",
                  "pm.collectionVariables.set('branchId', b.data[0].id);",
                  "console.log('Saved branchId:', b.data[0].id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/Branch",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "Branch"
              ]
            }
          }
        }
      ]
    },
