{
  "info": {
    "name": "PSP_08_AuditLog",
    "description": "Bộ kịch bản test tự động 100% nâng cao cho Phân hệ Nhật ký hệ thống (Module 18: AuditLog) của Phone Service Platform.\n\n**QUY TRÌNH KIỂM THỬ:**\n1. Đăng nhập Admin ➔ Tạo một nhân viên kiểm thử không có quyền ➔ Đăng nhập nhân viên kiểm thử.\n2. Lấy Token Admin thực hiện chuỗi CRUD trên Khách hàng: CREATE ➔ UPDATE ➔ DELETE (xóa mềm).\n3. Kiểm tra nhật ký: Truy vấn tất cả log, lọc theo thực thể CustomerEntity, lọc theo hành động DELETE.\n4. Kiểm thử ranh giới bảo mật: Sử dụng token của nhân viên không có quyền truy cập API Audit Log, mong đợi lỗi 403 Forbidden.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "techAccessToken",
      "value": ""
    },
    {
      "key": "customerId",
      "value": ""
    },
    {
      "key": "suffix",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "🔐 0. Auth & Setup",
      "item": [
        {
          "name": "0.1 Đăng nhập hệ thống (Admin)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const randomNum = Math.floor(100000 + Math.random() * 900000);",
                  "pm.collectionVariables.set('suffix', randomNum);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('code = SUCCESS', () => pm.expect(b.code).to.eql('SUCCESS'));",
                  "pm.collectionVariables.set('accessToken', b.data.accessToken);",
                  "console.log('✅ Admin logged in.');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"Admin@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/Auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "Auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "0.2 Tạo nhân viên kiểm thử phân quyền (Không gán Role)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('Tạo nhân viên thành công', () => pm.expect(b.code).to.eql('SUCCESS'));",
                  "console.log('✅ Created test technician.');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"branchId\": \"00000000-0000-0000-0000-000000000001\",\n  \"username\": \"tech_{{suffix}}\",\n  \"password\": \"Password@123\",\n  \"fullName\": \"Nhân viên kiểm thử {{suffix}}\",\n  \"email\": \"tech_{{suffix}}@psp.com\",\n  \"phone\": \"0986{{suffix}}\",\n  \"status\": \"Active\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/User",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "User"
              ]
            }
          }
        },
        {
          "name": "0.3 Đăng nhập với tư cách Nhân viên kiểm thử (Không có quyền)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('Đăng nhập thành công', () => pm.expect(b.code).to.eql('SUCCESS'));",
                  "pm.collectionVariables.set('techAccessToken', b.data.accessToken);",
                  "console.log('✅ Technician logged in.');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"tech_{{suffix}}\",\n  \"password\": \"Password@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/Auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "Auth",
                "login"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "⚙️ 1. Trigger Changes",
      "item": [
        {
          "name": "1.1 Tạo khách hàng mới (Trạng thái CREATE)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('Tạo thành công', () => pm.expect(b.code).to.eql('SUCCESS'));",
                  "pm.collectionVariables.set('customerId', b.data);",
                  "console.log('Saved customerId:', b.data);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Khách hàng Audit {{suffix}}\",\n  \"phone\": \"0912{{suffix}}\",\n  \"email\": \"audit_{{suffix}}@example.com\",\n  \"address\": \"Địa chỉ đăng ký log\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/Customer",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "Customer"
              ]
            }
          }
        },
        {
          "name": "1.2 Cập nhật thông tin khách hàng (Trạng thái UPDATE)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('Cập nhật thành công', () => pm.expect(b.code).to.eql('SUCCESS'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"{{customerId}}\",\n  \"fullName\": \"Khách hàng Audit {{suffix}} (Đã chỉnh sửa)\",\n  \"phone\": \"0912{{suffix}}\",\n  \"email\": \"audit_edit_{{suffix}}@example.com\",\n  \"address\": \"Địa chỉ đã cập nhật mới\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/Customer/{{customerId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "Customer",
                "{{customerId}}"
              ]
            }
          }
        },
        {
          "name": "1.3 Xóa khách hàng (Trạng thái DELETE)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('Xóa thành công', () => pm.expect(b.code).to.eql('SUCCESS'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/Customer/{{customerId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "Customer",
                "{{customerId}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "📝 2. Audit Logs Query",
      "item": [
        {
          "name": "[200] Lấy danh sách Audit Logs (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('Lấy danh sách thành công', () => pm.expect(b.code).to.eql('SUCCESS'));",
                  "pm.test('Có bản ghi log', () => pm.expect(b.data.items.length).to.be.above(0));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/AuditLog?pageIndex=1&pageSize=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "AuditLog"
              ],
              "query": [
                {
                  "key": "pageIndex",
                  "value": "1"
                },
                {
                  "key": "pageSize",
                  "value": "20"
                }
              ]
            }
          }
        },
        {
          "name": "[200] Lọc Audit Logs theo tên thực thể CustomerEntity",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('Lọc theo CustomerEntity thành công', () => pm.expect(b.code).to.eql('SUCCESS'));",
                  "if (b.data.items.length > 0) {",
                  "    pm.test('Thực thể khớp', () => pm.expect(b.data.items[0].entityName).to.eql('CustomerEntity'));",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/AuditLog?entityName=CustomerEntity",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "AuditLog"
              ],
              "query": [
                {
                  "key": "entityName",
                  "value": "CustomerEntity"
                }
              ]
            }
          }
        },
        {
          "name": "[200] Lọc Audit Logs theo hành động DELETE",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('Lọc theo DELETE thành công', () => pm.expect(b.code).to.eql('SUCCESS'));",
                  "if (b.data.items.length > 0) {",
                  "    pm.test('Hành động khớp', () => pm.expect(b.data.items[0].action).to.eql('DELETE'));",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/AuditLog?action=DELETE",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "AuditLog"
              ],
              "query": [
                {
                  "key": "action",
                  "value": "DELETE"
                }
              ]
            }
          }
        },
        {
          "name": "[403] Thử truy vấn Audit Logs bằng tài khoản không có quyền (Technician)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 403 Forbidden', () => pm.response.to.have.status(403));",
                  "console.log('✅ Kiểm thử ranh giới bảo mật thành công: Chặn nhân viên không có quyền.');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{techAccessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/AuditLog",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "AuditLog"
              ]
            }
          }
        }
      ]
    }
  ]
}
