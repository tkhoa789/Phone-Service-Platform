      "name": "🔐 0. Auth",
      "item": [
        {
          "name": "Đăng nhập hệ thống (Admin)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const randomNum = Math.floor(100000 + Math.random() * 900000);",
                  "pm.collectionVariables.set('suffix', randomNum);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('code = SUCCESS', () => pm.expect(b.code).to.eql('SUCCESS'));",
                  "pm.test('Có accessToken', () => pm.expect(b.data.accessToken).to.not.be.empty);",
                  "pm.collectionVariables.set('accessToken', b.data.accessToken);",
                  "pm.collectionVariables.set('adminUserId', b.data.user.id);",
                  "console.log('✅ Đăng nhập thành công, đã lưu Token và Admin UserId:', b.data.user.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"Admin@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/Auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "Auth",
                "login"
              ]
            }
          }
        }
      ]
