              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('Trạng thái Received', () => pm.expect(b.data.status).to.eql('Received'));",
                  "pm.test('Không có linh kiện', () => pm.expect(b.data.parts.length).to.eql(0));",
                  "pm.test('Lịch sử có 1 dòng', () => pm.expect(b.data.statusHistories.length).to.eql(1));",
                  "pm.test('PartsTotal = 0', () => pm.expect(b.data.partsTotal).to.eql(0));",
                  "pm.test('TotalAmount = LaborCost = 0', () => {",
                  "  pm.expect(b.data.laborCost).to.eql(0);",
                  "  pm.expect(b.data.totalAmount).to.eql(0);",
                  "});"
