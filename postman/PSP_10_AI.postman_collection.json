		{
			"name": "3. Chat RAG (Hoi dap chinh sach vua nap)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200 OK\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"var jsonData = pm.response.json();",
							"pm.test(\"AI returned response text\", function () {",
							"    pm.expect(jsonData.response).to.not.be.empty;",
							"});",
							"",
							"pm.test(\"Response contains warranty period matching context (9 months for battery or 3 months for glass)\", function () {",
							"    var text = jsonData.response.toLowerCase();",
							"    var containsCorrectInfo = text.includes(\"3 thang\") || text.includes(\"9 thang\") || text.includes(\"3\") || text.includes(\"9\");",
							"    pm.expect(containsCorrectInfo).to.be.true;",
							"});",
							"",
							"if (jsonData.conversationId) {",
							"    pm.collectionVariables.set('conversation_id', jsonData.conversationId);",
							"    pm.test(\"Conversation ID saved\", function () {",
							"        pm.expect(jsonData.conversationId).to.not.be.null;",
							"    });",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
