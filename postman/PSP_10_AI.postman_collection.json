							"var jsonData = pm.response.json();",
							"pm.test(\"Response code is SUCCESS\", function () {",
							"    pm.expect(jsonData.code).to.eql(\"SUCCESS\");",
							"});",
							"",
							"if (jsonData.code === 'SUCCESS') {",
							"    pm.collectionVariables.set('bearer_token', jsonData.data.accessToken);",
							"    pm.test(\"Bearer Token is saved to collection variable\", function () {",
							"        pm.expect(jsonData.data.accessToken).to.not.be.null;",
