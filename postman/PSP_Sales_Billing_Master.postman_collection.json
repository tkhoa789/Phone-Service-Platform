      "name": "🔐 0. Auth",
      "item": [
        {
          "name": "Đăng nhập hệ thống (Admin)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const randomNum = Math.floor(100000 + Math.random() * 900000);",
                  "pm.collectionVariables.set('suffix', randomNum);",
                  "pm.collectionVariables.set('voucherCode', 'MASTER_VOUCH_' + randomNum);",
                  "console.log('Master Suffix:', randomNum);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('Có Token', () => pm.expect(b.data.accessToken).to.not.be.empty);",
                  "pm.collectionVariables.set('accessToken', b.data.accessToken);",
                  "pm.collectionVariables.set('refreshToken', b.data.refreshToken);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"Admin@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/Auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "Auth",
                "login"
              ]
            }
          }
        }
