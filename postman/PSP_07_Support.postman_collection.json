              "raw": "{{baseUrl}}/Notification?pageIndex=1&pageSize=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "Notification"
              ],
              "query": [
                {
                  "key": "pageIndex",
                  "value": "1"
                },
                {
                  "key": "pageSize",
                  "value": "10"
                }
              ]
            }
          }
        },
        {
          "name": "[200] Lấy số lượng thông báo chưa đọc",
          "event": [
            {
              "listen": "test",
              "script": {
