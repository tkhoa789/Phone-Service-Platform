          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/Notification/unread-count",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "Notification",
                "unread-count"
              ]
            }
          }
        },
        {
          "name": "[200] Đánh dấu thông báo là đã đọc",
          "event": [
            {
              "listen": "test",
              "script": {
