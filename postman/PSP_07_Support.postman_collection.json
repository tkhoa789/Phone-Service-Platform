                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "entityName",
                  "value": "Products",
                  "type": "text"
                },
                {
                  "key": "entityId",
