{
  "info": {
    "name": "PSP - Customer Management (Module 11 - Auto Run)",
    "description": "Bộ kịch bản test tự động 100% cho Phân hệ Khách hàng (Module 11: Customer) của Phone Service Platform.\n\n**HƯỚNG DẪN:**\n1. Import file này vào Postman.\n2. Chọn Collection và click **Run Collection**.\n3. Nhấn **Run** để chạy toàn bộ kịch bản tự động.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "refreshToken",
      "value": ""
    },
    {
      "key": "suffix",
      "value": ""
    },
    {
      "key": "phone",
      "value": ""
    },
    {
      "key": "customerId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "🔐 0. Auth",
      "item": [
        {
          "name": "Đăng nhập hệ thống (Admin)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Sinh số điện thoại ngẫu nhiên bằng cách ghép 0987 và 6 số ngẫu nhiên",
                  "const randomNum = Math.floor(100000 + Math.random() * 900000);",
                  "pm.collectionVariables.set('suffix', randomNum);",
                  "pm.collectionVariables.set('phone', '0987' + randomNum);",
                  "console.log('Generated Phone:', '0987' + randomNum);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('code = SUCCESS', () => pm.expect(b.code).to.eql('SUCCESS'));",
                  "pm.test('Có accessToken', () => pm.expect(b.data.accessToken).to.not.be.empty);",
                  "pm.collectionVariables.set('accessToken', b.data.accessToken);",
                  "pm.collectionVariables.set('refreshToken', b.data.refreshToken);",
                  "console.log('✅ Đăng nhập thành công, đã lưu Token.');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"Admin@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/Auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "Auth",
                "login"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "👤 1. Customer CRUD",
      "item": [
        {
          "name": "[200] Tạo khách hàng mới (Thành công)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('Tạo hồ sơ thành công', () => pm.expect(b.code).to.eql('SUCCESS'));",
                  "pm.collectionVariables.set('customerId', b.data);",
                  "console.log('Saved customerId:', b.data);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Nguyễn Văn A {{suffix}}\",\n  \"phone\": \"{{phone}}\",\n  \"email\": \"vana_{{suffix}}@example.com\",\n  \"address\": \"123 Đường Lê Lợi, Quận 1\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/Customer",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "Customer"
              ]
            }
          }
        },
        {
          "name": "[409] Tạo khách hàng trùng số điện thoại (Lỗi)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 409', () => pm.response.to.have.status(409));",
                  "const b = pm.response.json();",
                  "pm.test('Báo lỗi trùng số điện thoại', () => pm.expect(b.message).to.include('đã được đăng ký'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Trần Thị B {{suffix}}\",\n  \"phone\": \"{{phone}}\",\n  \"email\": \"vtb_{{suffix}}@example.com\",\n  \"address\": \"456 Đường Lê Lợi, Quận 1\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/Customer",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "Customer"
              ]
            }
          }
        },
        {
          "name": "[200] Tra cứu khách hàng theo ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('Đúng họ tên', () => pm.expect(b.data.fullName).to.eql('Nguyễn Văn A ' + pm.collectionVariables.get('suffix')));",
                  "pm.test('Mã khách hàng tự sinh có dạng KH-', () => pm.expect(b.data.code).to.include('KH-'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/Customer/{{customerId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "Customer",
                "{{customerId}}"
              ]
            }
          }
        },
        {
          "name": "[200] Tra cứu khách hàng theo Số điện thoại",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('Đúng họ tên', () => pm.expect(b.data.fullName).to.eql('Nguyễn Văn A ' + pm.collectionVariables.get('suffix')));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/Customer/phone/{{phone}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "Customer",
                "phone",
                "{{phone}}"
              ]
            }
          }
        },
        {
          "name": "[200] Cập nhật thông tin khách hàng",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"{{customerId}}\",\n  \"fullName\": \"Nguyễn Văn A (Updated) {{suffix}}\",\n  \"phone\": \"{{phone}}\",\n  \"email\": \"vana_updated_{{suffix}}@example.com\",\n  \"address\": \"456 Đường Nguyễn Huệ, Quận 1\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/Customer/{{customerId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "Customer",
                "{{customerId}}"
              ]
            }
          }
        },
        {
          "name": "[200] Tìm kiếm khách hàng theo từ khóa",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('Tìm thấy khách hàng', () => pm.expect(b.data.length).to.be.above(0));",
                  "pm.test('Họ tên đã cập nhật thành công', () => pm.expect(b.data[0].fullName).to.include('(Updated)'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/Customer?keyword={{phone}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "Customer"
              ],
              "query": [
                {
                  "key": "keyword",
                  "value": "{{phone}}"
                }
              ]
            }
          }
        },
        {
          "name": "[200] Xóa khách hàng (Xóa mềm)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/Customer/{{customerId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "Customer",
                "{{customerId}}"
              ]
            }
          }
        },
        {
          "name": "[404] Tra cứu lại khách hàng sau khi xóa (Lỗi)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 404', () => pm.response.to.have.status(404));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/Customer/{{customerId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "Customer",
                "{{customerId}}"
              ]
            }
          }
        }
      ]
    }
  ]
}